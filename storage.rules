rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Blog görselleri: /blog/... altı
    match /blog/{allPaths=**} {
      // Herkes okur (herkese açık görseller)
      allow read: if true;

      // Sadece admin yazar (Storage'dan Firestore admins doc'una erişim)
      allow write: if request.auth != null
        && firestore.exists(
             /databases/(default)/documents/config/admins
           )
        && request.auth.uid in firestore.get(
             /databases/(default)/documents/config/admins
           ).data.uids
        && request.resource.size < 5 * 1024 * 1024   // max 5MB dosya
        && request.resource.contentType.matches('image/.*');  // sadece resim
    }
  }
}
