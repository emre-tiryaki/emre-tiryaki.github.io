rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ── Admin kontrolü: config/admins doc içindeki UID listesi ──
    function isAdmin() {
      return exists(/databases/$(db)/documents/config/admins)
        && request.auth != null
        && request.auth.uid in get(/databases/$(db)/documents/config/admins).data.uids;
    }

    // ── Admin UID listesi: kilitli, sadece admin okur, KİMSE yazamaz ──
    match /config/admins {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── POSTS ──
    match /posts/{postId} {
      // Herkes yayınlanmış postu okur
      allow read: if resource.data.published == true;
      // Sadece admin oluşturur / günceller / siler
      allow create, update, delete: if isAdmin();
    }

    // ── COMMENTS (herkese açık kısım: mail YOK) ──
    match /comments/{commentId} {
      // Admin her şeyi görür; halk sadece onaylı yorumları
      allow read: if isAdmin() || resource.data.status == 'approved';

      // Herkes (girişsiz) pending yorum bırakabilir.
      // - status ZORLA 'pending' (client 'approved' gönderemez)
      // - parentId ya null (ana yorum) ya da varolan BİR yorumun id'si
      // - 1-seviye kısıtı: yanıt verilen yorumun KENDİSİ ana yorum olmalı
      //   (yani parent.parentId == null) — böylece yanıtın yanıtı olmaz
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 60
        && (request.resource.data.parentId == null
            || (
              exists(/databases/$(db)/documents/comments/$(request.resource.data.parentId))
              && get(/databases/$(db)/documents/comments/$(request.resource.data.parentId)).data.parentId == null
            ));

      // Onay / ret / sil sadece admin
      allow update, delete: if isAdmin();
    }

    // ── COMMENT SECRETS (yorumcu maili — GİZLİ, halka açık comments'te YOK) ──
    match /commentSecrets/{commentId} {
      // Sadece admin okur
      allow read: if isAdmin();
      // Herkes (girişsiz) kendi yorumunun mailini yazabilir (sadece 'email' alanı)
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly(['email'])
        && (request.resource.data.email is string)
        && (request.resource.data.email.size() == 0
            || request.resource.data.email.size() <= 120);
      // Admin düzeltebilir / silebilir
      allow update, delete: if isAdmin();
    }
  }
}
