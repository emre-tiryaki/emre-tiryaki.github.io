rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sahibi: admins/{uid} belgesi Console'dan elle oluşturulur; istemciden okunamaz/yazılamaz.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Link değeri: https://, ≤ 200 karakter, boşluksuz (istemcide src/lib/guestbookLinks.js ile aynı kural).
    function validUrl(v) {
      return v is string && v.size() <= 200 && v.matches('^https://[^\\s]+$');
    }

    function validLinks(l) {
      return l is map
        && l.keys().hasOnly(['github', 'linkedin', 'website', 'x', 'instagram', 'youtube', 'other'])
        && l.keys().size() <= 4
        && (!('github' in l) || (validUrl(l.github) && l.github.matches('^https://(www\\.)?github\\.com/.*')))
        && (!('linkedin' in l) || (validUrl(l.linkedin) && l.linkedin.matches('^https://([a-z]+\\.)?linkedin\\.com/.*')))
        && (!('website' in l) || validUrl(l.website))
        && (!('x' in l) || validUrl(l.x))
        && (!('instagram' in l) || validUrl(l.instagram))
        && (!('youtube' in l) || validUrl(l.youtube))
        && (!('other' in l) || validUrl(l.other));
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    // Ziyaretçi defteri: sadece sahibi tarafından onaylanmış (approved == true) yorumlar okunur.
    match /guestbook/{id} {
      allow read: if resource.data.approved == true || isAdmin();

      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'avatar', 'links', 'publicEmail', 'approved', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'message', 'approved', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 500
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time
        && (!('avatar' in request.resource.data)
            || (request.resource.data.avatar is string
                && request.resource.data.avatar.size() < 30000
                && request.resource.data.avatar.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$')))
        && (!('links' in request.resource.data) || validLinks(request.resource.data.links))
        && (!('publicEmail' in request.resource.data)
            || (request.resource.data.publicEmail is string
                && request.resource.data.publicEmail.size() <= 120
                && request.resource.data.publicEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')));

      // Admin sadece approved ve teamMemberId (rozet) alanlarını değiştirebilir, yorumu silebilir.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'teamMemberId'])
        && request.resource.data.approved is bool
        && (!('teamMemberId' in request.resource.data)
            || (request.resource.data.teamMemberId is string && request.resource.data.teamMemberId.size() <= 40));
      allow delete: if isAdmin();
    }

    // E-posta ayrı koleksiyonda: herkes yazabilir, kimse okuyamaz (sahibi Console'dan görür).
    // Yorum belgesiyle aynı batch'te, aynı id ile yazılmak zorundadır.
    match /guestbookPrivate/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && existsAfter(/databases/$(database)/documents/guestbook/$(id));

      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
