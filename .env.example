# Firebase web app configuration
# Bu dosyayı kopyalayıp .env olarak kullan: cp .env.example .env
# .env DOSYASINI REPO'YA PUSHLAMA (.gitignore'da).
# Değerleri Firebase konsolu → Project settings → Your apps → Web app'ten al.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# GitHub aktivite ısı haritası için (opsiyonel)
VITE_GITHUB_TOKEN=
